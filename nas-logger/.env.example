# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored, so your key and password never get committed.

# Web app: the controller's IP address and the same key as
# LOCAL_CONTROL_KEY in HomeAutomation/secrets.h
DEVICE_IP=192.168.1.50
DEVICE_KEY=change-me-to-a-random-string

# Login for the web page
WEB_USER=admin
WEB_PASSWORD=choose-a-strong-password

# Optional
# RELAY_NAMES=Gate,Garage        # relays show as Switch 1-8 by default
# WEB_PORT=8080                  # host port for the web page
# LOG_PATH=/volume1/homeauto-logs  # where the daily log files are stored
